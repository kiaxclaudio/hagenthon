# Copia in .env e riempi. .env non va MAI committato.
ANTHROPIC_API_KEY=sk-ant-...

# --- Model tiering -----------------------------------------------------------
# I tre tier usati dalla mappa agente -> tier in app/config.py.
# CHEAP: orchestrator, profiler, navigator
# WORK:  explainer, eligibility
# DEEP:  source-analyzer, fidelity-validator
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_WORK=claude-sonnet-5
ANTHROPIC_MODEL_DEEP=claude-opus-5

# --- Resilienza delle chiamate al modello ------------------------------------
# Timeout in secondi per ogni chiamata al modello
LLM_TIMEOUT_S=60
# Numero massimo di retry con backoff esponenziale
LLM_MAX_RETRIES=3
# Attesa del primo retry, in secondi (poi raddoppia a ogni tentativo)
LLM_BACKOFF_BASE_S=1
# Tetto dell'attesa fra due tentativi, in secondi
LLM_BACKOFF_MAX_S=20

# --- Modalita demo -----------------------------------------------------------
# true = nessuna chiamata all'API: gli output degli agenti vengono da app/demo/,
# validati contro gli stessi schemi. Il catalogo resta quello verificato in
# agents/state/catalogo.json. L'interfaccia dichiara la modalita in alto.
DEMO_MODE=false

# --- Server ------------------------------------------------------------------
# Se assente, ne viene generato uno casuale a ogni avvio
FLASK_SECRET_KEY=
FLASK_PORT=5000
FLASK_DEBUG=false
